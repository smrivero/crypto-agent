# ── LLM ──────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=your_openai_api_key_here
# Override to use any OpenAI-compatible endpoint (e.g. Ollama, Together, etc.)
OPENAI_BASE_URL=https://api.openai.com/v1
MODEL_NAME=gpt-5.4-mini

# ── API Server ────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=false

# ── Agent ─────────────────────────────────────────────────────────────────────
MAX_SEARCH_RESULTS=5
AGENT_TIMEOUT=120

# ── Tavily (web search) ───────────────────────────────────────────────────────
# https://tavily.com — if unset, search falls back to mock results
TAVILY_API_KEY=

# ── Blockchain RPC (optional — public fallback if empty) ───────────────────────
# ETHEREUM_RPC_URL=
# BASE_RPC_URL=
# POLYGON_RPC_URL=
# ARBITRUM_RPC_URL=

# ── Block explorer ─────────────────────────────────────────────────────────────
# ETHERSCAN_API_KEY: opcional; tokeninfo/holders en Etherscan requiere API Pro.
# Sin Pro, holders se obtienen por Blockscout (gratis). https://etherscan.io/myapikey
ETHERSCAN_API_KEY=
# Opcional: keys por red si prefieres endpoints legacy
# BASESCAN_API_KEY=
# POLYGONSCAN_API_KEY=
# ARBISCAN_API_KEY=

# ── x402 (Base Sepolia testnet) ───────────────────────────────────────────────
X402_NETWORK=base-sepolia

# Facilitator: selección en la UI (dropdown). Por defecto: public x402.org

# Public facilitator (signup-free testnet)
X402_PUBLIC_FACILITATOR_URL=https://x402.org/facilitator
# Legacy alias still supported:
# X402_FACILITATOR_URL=https://x402.org/facilitator

# Coinbase CDP facilitator (https://api.cdp.coinbase.com/platform/v2/x402)
# CDP_API_KEY_ID=
# CDP_API_KEY_SECRET=
# CDP_PROJECT_ID=

# Seller wallet — receives USDC (public address only, no private key)
X402_RECEIVING_WALLET_ADDRESS=
# X402_DEMO_PRICE=$0.01

# Buyer test wallet — scripts/x402_buyer_test.py (CLI). Never commit.
# EVM_PRIVATE_KEY=

# ── Frontend (frontend/.env) ─────────────────────────────────────────────────
# VITE_WALLETCONNECT_PROJECT_ID=  # WalletConnect — https://cloud.walletconnect.com
